{
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "overrides": [
    {
      "files": ["*.xml", "*.json", "*.sql"],
      "options": {
        "printWidth": 120,
        "tabWidth": 4
      }
    },
    {
      "files": ["*.html", "*.md"],
      "options": {
        "printWidth": 160,
        "tabWidth": 2
      }
    }
  ]
}
